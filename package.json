{
  "name": "agent-customization-inspector",
  "version": "0.8.0",
  "description": "Browse and inspect instructions, skills, MCP settings, and other customization files for AI coding agents.",
  "homepage": "https://github.com/ota-meshi/agent-customization-inspector#readme",
  "bugs": {
    "url": "https://github.com/ota-meshi/agent-customization-inspector/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ota-meshi/agent-customization-inspector.git"
  },
  "license": "MIT",
  "author": {
    "name": "Yosuke Ota",
    "url": "https://github.com/ota-meshi"
  },
  "funding": "https://github.com/sponsors/ota-meshi",
  "type": "module",
  "bin": {
    "agent-customization-inspector": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node scripts/clean-build-output.mjs",
    "dev:prepare": "nuxt prepare",
    "build": "node scripts/clean-build-output.mjs && nuxt build && tsdown",
    "start": "node dist/cli.mjs",
    "start:fixture": "node scripts/serve-fixture.ts",
    "build-and-start": "pnpm run build && pnpm run start",
    "check:official-sources": "node scripts/check-official-sources.ts",
    "docs:images": "pnpm run build && node scripts/readme-images/capture.ts",
    "verify:package": "node scripts/verify-package-files.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "test:integration": "vitest run --project integration",
    "test:security": "vitest run --project security",
    "test:package": "vitest run --project package",
    "test:docs": "vitest run --project documentation",
    "test:performance": "vitest run --project performance",
    "test:coverage": "vitest run --project coverage --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "devframe": "^1.0.0",
    "env-editor": "^1.3.0",
    "gunshi": "^0.37.0",
    "h3": "^2.0.3",
    "open": "^11.0.1",
    "smol-toml": "^1.7.0",
    "strip-json-comments": "^5.0.3",
    "vfile": "^6.0.3",
    "vfile-matter": "^5.0.1",
    "which": "^7.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@iconify-json/lucide": "^1.2.124",
    "@iconify-json/simple-icons": "^1.2.93",
    "@iconify-json/thesvg": "^1.2.4",
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/test-utils": "^4.0.3",
    "@playwright/test": "^1.61.1",
    "@shikijs/themes": "^4.4.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.13.3",
    "@types/which": "^3.0.4",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.7.0",
    "happy-dom": "^21.0.0",
    "nuxt": "^4.4.8",
    "playwright": "^1.61.1",
    "prettier": "^3.9.6",
    "shiki": "^4.4.3",
    "shine-and-bright": "^0.3.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0",
    "vscode-diff": "^3.0.1",
    "vue": "^3.5.39",
    "vue-router": "^5.2.0",
    "vue-tsc": "^3.3.7"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^24.11.0 || ^26.0.0"
  }
}
