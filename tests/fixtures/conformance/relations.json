{
  "strategies": {
    "claude.skills.selection": {
      "consumesBehaviors": ["claude.behavior.repo.skills", "claude.behavior.user.skills"]
    },
    "codex.config.precedence": {
      "consumesBehaviors": ["codex.behavior.repo.config", "codex.behavior.user.config"]
    },
    "codex.instructions.layering": {
      "consumesBehaviors": ["codex.behavior.repo.instructions", "codex.behavior.user.instructions"]
    },
    "codex.skills.discovery": {
      "consumesBehaviors": ["codex.behavior.repo.skills", "codex.behavior.user.skills"]
    },
    "copilot.cli.skills.selection": {
      "consumesBehaviors": [
        "copilot.behavior.cli.commands",
        "copilot.behavior.cli.skills",
        "copilot.behavior.cli.user.skills"
      ]
    },
    "copilot.cloud.skills.selection": {
      "consumesBehaviors": ["copilot.behavior.cloud.remote-skills", "copilot.behavior.cloud.skills"]
    },
    "copilot.vscode.skills.selection": {
      "consumesBehaviors": ["copilot.behavior.vscode.skills", "copilot.behavior.vscode.user.skills"]
    }
  },
  "rules": {
    "claude.repo.skill": {
      "basedOnBehaviors": ["claude.behavior.repo.skills"],
      "explainedByStrategies": ["claude.skills.selection"]
    },
    "codex.derived.fallback-basename": {
      "basedOnBehaviors": ["codex.behavior.repo.config", "codex.behavior.repo.instructions"],
      "explainedByStrategies": ["codex.config.precedence", "codex.instructions.layering"]
    },
    "codex.repo.instructions": {
      "basedOnBehaviors": ["codex.behavior.repo.instructions"],
      "explainedByStrategies": ["codex.instructions.layering"]
    },
    "codex.repo.skill": {
      "basedOnBehaviors": ["codex.behavior.repo.skills"],
      "explainedByStrategies": ["codex.skills.discovery"]
    },
    "copilot.repo.skill": {
      "basedOnBehaviors": [
        "copilot.behavior.cli.skills",
        "copilot.behavior.cloud.skills",
        "copilot.behavior.vscode.skills"
      ],
      "explainedByStrategies": [
        "copilot.cli.skills.selection",
        "copilot.cloud.skills.selection",
        "copilot.vscode.skills.selection"
      ]
    }
  }
}
