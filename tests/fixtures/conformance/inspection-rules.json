        "reviewedOn": "2026-08-08",
        "establishes": "Repository skills live at .claude/skills/<skill-name>/SKILL.md on each layer from the working directory through the repository root, which is why this rule admits that shape at the selected root and every descendant directory."
      },
      {
        "sourceId": "anthropic.claude-code.plugins.components-scopes",
        "url": "https://code.claude.com/docs/en/plugins-reference",
        "officialHost": "code.claude.com",
