{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "checkJs": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true
  },
  "include": [
    ".nuxt/nuxt.d.ts",
    ".nuxt/nuxt.node.d.ts",
    "src/**/*",
    "eslint-rules/**/*",
    "scripts/**/*",
    "tests/**/*",
    "nuxt.config.ts",
    "tsdown.config.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "eslint.config.js"
  ],
  "exclude": ["node_modules", ".output", "dist", "coverage", "playwright-report", "test-results"]
}
